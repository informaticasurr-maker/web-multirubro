rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir lectura y escritura a las tiendas, citas, barberos y configuraciones
    match /shops/{shopId} {
      allow read, write: if true;
    }
    match /shops_registry/{shopId} {
      allow read, write: if true;
    }
    match /admin_users/{userId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
